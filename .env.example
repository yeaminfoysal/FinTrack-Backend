# Copy to .env and fill in real values.

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- App ---
PORT=3000

# --- JWT ---
# Generate strong secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="90d"

# --- Password reset / email (Resend) ---
# Leave RESEND_API_KEY empty in dev to log reset links instead of sending email.
RESEND_API_KEY=""
MAIL_FROM="FinTrack <onboarding@resend.dev>"
PASSWORD_RESET_URL="fintrack://reset-password"
PASSWORD_RESET_EXPIRES_MIN=60
